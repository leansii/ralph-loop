# Ralph Loop Configuration
# Copy to .env and adjust as needed. All values shown are defaults.

# ── Models ──
MODEL_IMPLEMENT=sonnet          # Model for task implementation
MODEL_REVIEW=sonnet             # Model for code review
MODEL_MERGE=sonnet              # Model for merging review deltas
FALLBACK_MODEL=haiku            # Auto-fallback when primary is overloaded

# ── Iteration limits ──
MAX_ITERATIONS=50               # Stop after this many iterations
MAX_REVIEW_ROUNDS=3             # Max review cycles per task before force-accepting
MAX_BUDGET_USD=                  # Optional: stop when spending exceeds this (e.g. "5.00")

# ── Review ──
PARALLEL_REVIEWS=true           # Run 4 reviewers in parallel (false = sequential)

# ── Rate limit handling ──
RATE_LIMIT_MAX_RETRIES=10       # Give up after this many consecutive rate limits
WAIT_RATE_LIMIT=60              # Seconds to wait on 429 rate limit
WAIT_OVERLOADED=30              # Seconds to wait on 529 server overload
WAIT_USAGE_CAP=300              # Seconds to wait on usage/spending cap
WAIT_MAX=900                    # Absolute max wait (15 min)
WAIT_EMPTY_RESPONSE=30          # Seconds to wait on empty response

# ── Tools ──
ALLOWED_TOOLS="Read Write Edit Bash Grep Glob"
STREAM_OUTPUT=true              # Show claude output in real-time

# ── Project paths (relative to PROJECT_ROOT) ──
TASKS_FILE=tasks.md             # Task list file
SPEC_FILE=CLAUDE.md             # Specification / conventions file
RALPH_STATE_DIR=.ralph          # Directory for ralph state files
PROGRESS_FILE=.ralph/progress.md  # Iteration progress log

# ── Project root (optional — auto-detected if script is in .ralph/) ──
# PROJECT_ROOT=/path/to/project
